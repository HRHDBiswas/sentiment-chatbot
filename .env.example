# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real tokens to version control.
#
# Usage (macOS/Linux):  export $(cat .env | xargs)
# Usage (Windows CMD):  for /f "tokens=*" %i in (.env) do set %i

# Required: HuggingFace Inference API token
# Generate one at https://huggingface.co/settings/tokens (free account)
HF_API_TOKEN=hf_your_token_here

# Optional: override the default model endpoint
# HF_MODEL_ENDPOINT=https://api-inference.huggingface.co/models/cardiffnlp/twitter-roberta-base-sentiment-latest

# Optional: request timeout in seconds (default: 15)
# REQUEST_TIMEOUT_SECONDS=15
